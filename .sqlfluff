[sqlfluff]
dialect = duckdb
templated_dialect = duckdb
# Игнорируем конфликтующие базовые правила разметки, чтобы применились наши
ignore = parsing
exclude_rules = LT01, LT02, LT09

[sqlfluff:indentation]
# Настраиваем отступы под выравнивание по правому краю
indent_unit = space
tab_space_size = 5
align_joins = true

[sqlfluff:layout:type:comma]
# Запятая переносится в начало строки и "прилипает" к тексту справа
line_position = leading
spacing_before = touch

[sqlfluff:rules:capitalisation.keywords]
# Ключевые слова строго ЗАГЛАВНЫМИ
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
# Названия таблиц/колонок строго строчными
capitalisation_policy = lower

[sqlfluff:rules:aliasing.expression]
# Требуем обязательный оператор AS для алиасов колонок
aliasing_obligation = explicit

[sqlfluff:rules:layout.select_targets]
# Каждое поле обязательно с новой строки
wildcard_policy = single
